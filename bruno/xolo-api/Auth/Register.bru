meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Xolo QA",
    "email": "xolo.qa@example.com",
    "password": "password123"
  }
}

script:post-response {
  const body = res.getBody();
  if (body?.data?.token) {
    bru.setEnvVar("token", body.data.token);
  }
}
