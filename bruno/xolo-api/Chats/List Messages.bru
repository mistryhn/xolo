meta {
  name: List Messages
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/chats/{{chatId}}/messages
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

script:post-response {
  const body = res.getBody();
  const messages = body?.data ?? [];
  if (messages.length) {
    bru.setEnvVar("messageId", messages[messages.length - 1].id);
  }
}
