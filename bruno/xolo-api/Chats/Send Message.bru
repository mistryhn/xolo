meta {
  name: Send Message
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/chats/{{chatId}}/messages
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "body": "Hello from Example",
    "clientId": "{{$guid}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body?.data?.id) {
    bru.setEnvVar("messageId", body.data.id);
  }
}
